# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in real values before running.
# ---------------------------------------------------------------------

PROJECT_NAME="Hospital Appointment Management System"
ENVIRONMENT=development
DEBUG=true

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hims_appointment_db
# Optional: overrides the assembled URL above if set
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hims_appointment_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# JWT
SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Business rules
DEFAULT_APPOINTMENT_DURATION_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
